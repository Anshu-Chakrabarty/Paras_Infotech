{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/makeen_reports", "destination": "/makeen_reports/index.html" },
    { "source": "/makeen_reports/", "destination": "/makeen_reports/index.html" },
    { "source": "/makeen_reports/:path((?!assets/).*)", "destination": "/makeen_reports/index.html" },
    { "source": "/((?!api/|assets/|favicon\\.|apple-touch-icon\\.png).*)", "destination": "/index.html" }
  ]
}

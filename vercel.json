{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/bricks&bytes", "destination": "/bricks&bytes/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/makeen_reports", "destination": "/makeen_reports/index.html" },
    { "source": "/makeen_reports/", "destination": "/makeen_reports/index.html" },
    { "source": "/makeen_reports/:path((?!assets/).*)", "destination": "/makeen_reports/index.html" },
    { "source": "/((?!api/|assets/|bricks&bytes|favicon\\.|apple-touch-icon\\.png).*)", "destination": "/index.html" }
  ]
}
